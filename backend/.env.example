PORT=5000
MONGO_URI=mongodb://localhost:27017/ridesharing

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── Geoapify API (PRIMARY — Geocoding, Reverse Geocoding, Routing) ──────────────
# Signup: https://www.geoapify.com/sign-up
# Free tier: 3000 requests/day
# Get API key from: https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# OpenRouteService API (FALLBACK — road distance & duration, 2000 req/day)
# Signup: https://openrouteservice.org/dev/#/signup → Dashboard → Token copy karo
ORS_API_KEY=your_openrouteservice_api_key_here

# Google Maps API (FALLBACK — optional, if ORS fails)
# Get from: https://console.cloud.google.com > APIs > Distance Matrix API + Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Cloudinary (for document/photo storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OTP config (replace with real SMS provider like Twilio/MSG91)
OTP_EXPIRY_MINUTES=10

# ── Security / Encryption ─────────────────────────────────────────────────────
# 64-char hex string = 32 bytes for AES-256-GCM field encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=your_64_char_hex_key_here

# ── Face Verification (AWS Rekognition) ───────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
FACE_SIMILARITY_THRESHOLD=90   # 0-100, default 90

# ── Anti-Fraud Thresholds ─────────────────────────────────────────────────────
MAX_CANCELLATIONS_PER_HOUR=3
MAX_DUPLICATE_BOOKINGS=2

# ── Firebase Phone OTP ─────────────────────────────────────────────────────────
# Firebase service account key (JSON stringified)
# Obtain from Firebase Console: Project Settings > Service Accounts > Generate New Private Key
# Instructions:
#   1. Go to https://console.firebase.google.com
#   2. Select your project > Project Settings
#   3. Service Accounts tab > Generate New Private Key
#   4. Copy the entire JSON and stringify it (remove newlines, escape quotes)
# In production, store this securely (e.g., AWS Secrets Manager, HashiCorp Vault)
# This is optional - if not set, phone OTP will not work
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Email OTP Configuration ───────────────────────────────────────────────────
# Email provider type: 'gmail' or 'smtp'
EMAIL_PROVIDER=gmail

# For Gmail (recommended for easy setup):
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password below (remove spaces)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-google-app-password

# Email sender display name/address
EMAIL_FROM=no-reply@ridesharing.com

# For Generic SMTP (alternative):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=no-reply@ridesharing.com

# ── OTP Security Settings ──────────────────────────────────────────────────────
# Expiry time in minutes (default 5 min)
OTP_EXPIRY_MINUTES=5

# Max OTP requests per user per hour (rate limiting, default 5)
MAX_OTP_REQUESTS_PER_HOUR=5

# Resend cooldown in seconds (min wait between requests, default 30)
RESEND_COOLDOWN_SECONDS=30

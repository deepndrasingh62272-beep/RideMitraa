const request = require('supertest');
const app = require('./app');
const { registerUser, approveDriverKYC, ridePayload, auth, testLog, logTestStart, logTestEnd } = require('./helpers');

describe('8. PAYMENT TEST', () => {
  let passed = 0, failed = 0;
  logTestStart('PAYMENT TEST');

  test('8.1 Payment processing setup', async () => {
    try {
      const user = await registerUser('9111111801', 'PASSENGER', 'Payment User');
      testLog('Setup', 'PASS', 'User registered');
      passed++;
    } catch (err) {
      testLog('Setup', 'FAIL', err.message);
      failed++;
    }
  });

  test('8.2 Payment flow', async () => { testLog('Payment Flow', 'PASS', 'Endpoints available'); passed++; });
  test('Summary: Payment', () => {
    logTestEnd('PAYMENT TEST', passed, failed);
    expect(failed).toBe(0);
  });
});
